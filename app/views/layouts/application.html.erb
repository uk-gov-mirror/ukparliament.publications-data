<!DOCTYPE html>
<html>
  <head>
    <%= render 'library_design/head/head' %>
    <%= tag('base', href: ENV['BASE_URL']) if Rails.env.production? %>
  </head>

  <body class="brand-bicameral">
    <%= render 'library_design/header/header' do %>
      <%= render 'layouts/login_in_out' unless $DISABLE_AUTHENTICATION %>
      <%= link_to 'People', people_path %>&middot;
      <%= link_to 'Publications', publications_path %>&middot;
      <%= link_to 'Houses', houses_path %>&middot;
      <%= link_to 'Research services', research_services_path %>&middot;
      <%= link_to 'Sections', sections_path %>&middot;
      <%= link_to 'Collections', collections_path %>&middot;
      <%= link_to 'Concepts', concepts_path %>&middot;
      <%= link_to 'Geographic areas', geographic_areas_path %>&middot;
      <%= link_to 'Disclaimers', disclaimers_path %>
    <% end %>
    <main class="block block-page" id="main-content">
      <% if alert.present? %>
        <div class="attention-banner">
          <div class="container">
            <%= alert %>
          </div>
        </div>
      <% end %>

      <div class="inner-content container">
        <h1><%= @multiline_page_title || @page_title || $PRODUCT_TITLE %></h1>
        <%= yield %>
      </div>
    </main>
    <%= render 'library_design/footer/fat_footer' do %>
      <li><%= link_to 'Contact us', 'mailto:RIIDMSMailbox@parliament.uk' %></li>
      <li><%= link_to 'Examples', examples_path %></li>
      <li><%= link_to 'Log in', saml_sso_login_path unless session[:user_id] %></li>
      <li><%= link_to 'Log out', saml_sso_logout_path, data: { turbo_method: :delete } if session[:user_id] %></li>
    <% end %>
  </body>
</html>
