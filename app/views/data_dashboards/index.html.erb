<div class="block">
  <div class="tabs">
    <ul class="nav-tabs" role="tablist">
      <li role="presentation"><%= link_to 'All', data_dashboards_path, role: "tab", class: class_names(active: current_page?(data_dashboards_path)) %></li>
      <li role="presentation"><%= link_to 'Power BI', power_bi_data_dashboards_path, role: "tab", class: class_names(active: current_page?(power_bi_data_dashboards_path)) %></li>
      <li role="presentation"><%= link_to 'Shiny', shiny_data_dashboards_path, role: "tab", class: class_names(active: current_page?(shiny_data_dashboards_path)) %></li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane active" role="tabpanel">
        <%= render 'publications/table', publications: @publications, pagy: @pagy, total_count: @total_count, path_helper: :data_dashboard_path %>
      </div>
    </div>
  </div>
</div>
