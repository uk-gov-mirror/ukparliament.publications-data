<p>Short name: <b><%= @research_service.short_name %></b></p>

<p>For the: <b>
  <%= @research_service.houses.map do |house_id, house_name| %>
    <% link_to house_name, house_path(house_id) %>
  <% end.join(', ').html_safe %>
</b></p>

<div class="block">
  <div class="tabs">
    <%= render 'tab_nav' %>
    <div class="tab-content">
      <div class="tab-pane active" role="tabpanel">
        <div class="mt-3 mb-3">
          <p>Count: <%= @total_count %></p>
          <% if @total_count > @pagy.limit %>
            <%== @pagy.series_nav(:bootstrap) %>
          <% end %>
        </div>

        <% if @collections.any? %>
          <%= render 'collections/table', collections: @collections %>

        <% else %>
          <h2>No promoted collections</h2>
        <% end %>
      </div>
    </div>
  </div>
</div>
