<p>Short name: <b><%= @research_service.short_name %></b></p>

<p>For the: <b>
  <%= @research_service.houses.map do |house_id, house_name| %>
    <% link_to house_name, house_path(house_id) %>
  <% end.join(', ').html_safe %>
</b></p>


<div class="block">
  <div class="tabs">
    <ul class="nav-tabs" role="tablist">
      <li role="presentation"><%= link_to 'Publications', publications_research_service_path, role: "tab", class: class_names(active: current_page?(publications_research_service_path)) %></li>
      <li role="presentation"><%= link_to 'Sections', sections_research_service_path, role: "tab", class: class_names(active: current_page?(sections_research_service_path)) %></li>
      <li role="presentation"><%= link_to 'Promoted concepts', promoted_concepts_research_service_path, role: "tab", class: class_names(active: current_page?(promoted_concepts_research_service_path)) %></li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane active" role="tabpanel">
        <div class="mt-3 mb-3">
          <p>Count: <%= @total_count %></p>
          <% if @total_count > @pagy.limit %>
            <%== @pagy.series_nav(:bootstrap) %>
          <% end %>
        </div>

        <% if @concepts.any? %>
          <div class="card-list card-list-3-col">
            <% @concepts.each do |concept| %>
              <%= link_to concept_path(concept.id), class: "card" do %>
                <div class="card-inner">
                  <div class="content">
                    <div class="primary-info"><%= concept.concept_name %></div>
                  </div>
                  <div class="info">
                    <div class="info-inner">
                      <div class="indicators-left">
                        <div class="indicator indicator-label">Publication count: <%= concept.publications_count %></div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <h2>No promoted concepts</h2>
        <% end %>
      </div>
    </div>
  </div>
</div>
