<% if @optional_extras.geographic_areas.any? %>
  <div class="highlight highlight-warning">
    This work is geographically covers: <%= geographic_area_links_from_array(@optional_extras.geographic_areas) %>
  </div>

<% end %>

<% if  @optional_extras.superseded_by.any? %>
  <div class="highlight highlight-warning">
    This work is superseded by:
    <% @optional_extras.superseded_by.each do |s| %>
      <%= link_to s.title, publication_path(s.id) %>
    <% end %>
  </div>
<% end %>

<p>
  <% if @publication.research_service_id %>
    Published by the <b><%= link_to @publication.research_service_name, research_service_path(@publication.research_service_id) %></b>
  <% else %>
    We do not have information about who was to have published this publication.
  <% end %>
</p>

<p><i><%= @teaser_text %></i></p>

<% if @optional_extras.collections.any? %>
  <p>Is part of these collections:</p>
  <ul>
    <% @optional_extras.collections.each do |id, name| %>
      <li><%= link_to name, collection_path(id) %></li>
    <% end %>
  </ul>
<% end %>

<% if @optional_extras.lead_member_for_collections.any? %>
  <p>Is lead member for these collections:</p>
  <ul>
    <% @optional_extras.lead_member_for_collections.each do |id, name| %>
      <li><%= link_to name, collection_path(id) %></li>
    <% end %>
  </ul>
<% end %>

<% if @withdrawal_periods.any? %>
  <% @withdrawal_periods.each do |wp| %>
    <%= tag.div class: class_names(
      "highlight",
      "highlight-error": wp.reinstated_at.blank?,
      "highlight-info": wp.reinstated_at.present?
    ) do %>
      <p>
        <b>Withdrawn from <%= nice_date_time(wp.withdrawn_at) %></b>
        <% if wp.reinstated_at %>
          - re-instated at: <b><%= nice_date_time(wp.reinstated_at) %></b>
        <% end %>
      </p>
    <% end %>
  <% end %>
<% else %>
  <p>No withdrawal periods</p>
<% end %>

<% if @disclaimers.any? %>
  <% @disclaimers.each do |label, from| %>
    <div class="highlight highlight-warning">
      <p><%= label %> Applicable from: <%= nice_date(from) %></p>
    </div>
  <% end %>
<% else %>
  <p>No disclaimers</p>
<% end %>

<p>Reference: <b><%= @publication.ref.presence || "We do not have a reference for this publication." %></b></p>
<p>DOI:
  <% if @publication.doi.presence %>
    <%= link_to @publication.doi, "https://doi.org/#{@publication.doi}" %>
  <% else %>
    We do not have a DOI for this publication.
  <% end %>
</p>
<p>Created on: <b><%= nice_date_time @publication.created_at %></b></p>
<p>Updated on: <b><%= nice_date_time @publication.updated_at %></b></p>
<p>Version: <b><%= @publication.version_number %></b></p>

<% if @optional_extras.supersedes.any? %>
  <div class="highlight highlight-info">
    This work supersedes:

    <% @optional_extras.supersedes.each do |s| %>
      <%= link_to s.title, publication_path(s.id) %>
    <% end %>
  </div>
<% end %>

<% if @optional_extras.merged_from.any? %>
  <div class="highlight highlight-info">
    This work is merged from: <%= publication_links_from_array_of_objects(@optional_extras.merged_from) %>
  </div>
<% end %>

<% if @optional_extras.split_from.any? %>
  <div class="highlight highlight-info">
    This work is split from: <%= publication_links_from_array_of_objects(@optional_extras.split_from) %>
  </div>
<% end %>

<h3>Associated concepts</h3>
<% if @optional_extras.concepts.any? %>
  <% @optional_extras.concepts.each do |c| %>
    <span class="badge badge-primary"><%= link_to c.label, concept_path(c.id), class: "text-white" %></span>
  <% end %>
<% else %>
  <p>We do not have any associated concepts for this publication</p>
<% end %>

<h3>Contributions</h3>
<% if @contributions.any? %>
  <% @contributions.each do |contribution| %>
    <p><%= link_to contribution.person_name, person_path(contribution.person_id ) %> as <%= contribution.contribution_type %> - a <%= contribution.is_contribution_public ? "public" : "private" %> contribution</p>
  <% end %>
<% else %>
  <p>We do not have any contributors in our records for this publication.</p>
<% end %>

<h3>Related links</h3>
<% if @related_links.any? %>
  <ul>
    <% @related_links.each do |related_link| %>
      <li><%= link_to related_link.title, related_link.url %></li>
    <% end %>
  </ul>
<% else %>
  <p>We do not have any related links for this expression.</p>
<% end %>

<h3>Resources</h3>
<% if @resources.any? %>
  <% @resources.each do |resource| %>
    <%= link_to resource.public_url, class: "card" do %>
      <div class="card-inner">
        <div class="content">
          <div class="primary-info"><%= resource.file_title %></div>
          <div class="secondary-info">Label: <%= resource.file_label %></div>
          <div class="tertiary-info">Private URL: <%= resource.private_url %></div>
          <div class="tertiary-info">
            <% if resource.mime_type == "application/pdf" && resource.public_url %>
              <details>
                <summary>Show preview of PDF</summary>
                <iframe src="<%= resource.public_url %>" width="80%" height="300px" type="application/pdf" title="Embedded PDF">
                  <p>Your browser doesn't support PDF preview. <a href="<%= @pdf_url %>">Download it instead.</a></p>
                </iframe>
              </details>
            <% end %>
          </div>
        </div>

        <div class="info">
          <div class="info-inner">
            <div class="indicators-left">
              <div class="indicator indicator-label"><%= resource.mime_type %></div>
            </div>
            <div class="indicators-right">
              <div class="indicator">
                <i class="fas fa-hdd"></i>
                <%= number_to_human_size resource.file_size_in_bytes %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p>We do not have any file resources linked to this publication</p>
<% end %>

<h2>Expressions of this publication</h2>
<%= link_to "Expressions/Versions of this publication", publication_expressions_path(@publication_work_id) %>
