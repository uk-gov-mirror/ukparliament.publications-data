<h1><small class="text-muted"><%= @house.short_name %></small></h1>

<div class="block">
  <div class="tabs">
    <%= render 'tab_nav', this_path: business_item_weeks_for_a_year_and_house_path %>

    <div class="tab-content">
      <div class="tab-pane active" role="tabpanel">
        <ul>
          <% @week_numbers.each do |week_number| %>
            <li><%= link_to "Week number - #{week_number}", business_items_for_a_week_and_house_path(week_number: week_number, year: @year, id: @house.id) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
