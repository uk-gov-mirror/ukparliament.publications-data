<h1><small class="text-muted"><%= @house.short_name %></small></h1>

<div class="block">
  <div class="tabs">
    <%= render 'tab_nav', this_path: business_items_house_path %>

    <div class="tab-content">
      <div class="tab-pane active" role="tabpanel">
        <ul>
          <% @years.each do |year| %>
            <li><%= link_to year, business_item_weeks_for_a_year_and_house_path(@house.id, year) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
