<div class="block">
  <div class="tabs">
    <ul class="nav-tabs" role="tablist">
      <% @letters.each do |letter| %>
        <li role="presentation">
          <%= link_to letter, people_path(letter: letter), role: "tab", class: ("active" if letter == @letter) %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<div class="mt-3 mb-3">
  <p>Count: <%= @total_count %></p>
  <% if @total_count > @pagy.limit %>
    <%== @pagy.series_nav(:bootstrap) %>
  <% end %>
</div>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col" class="col-8">Name</th>
      <th scope="col" class="col-4">Number of contributions</th>
    </tr>
  </thead>
  <tbody>
    <% @people.each do |person| %>
    <tr>
      <th scope="row"> <%= link_to person.sort_name, person_path(person.id) %></th>
      <td><%= person.number_of_contributions %></td>
    </tr>
    <% end %>
  </tbody>
</table>
